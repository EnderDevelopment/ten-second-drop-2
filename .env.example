# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Your Discord user ID. Only this user can run /drop.
OWNER_ID=your_discord_user_id_here

# Optional public image URL shown on the drop embed
DROP_IMAGE_URL=https://example.com/drop-image.png

# Minimum seconds between /drop commands
DROP_COOLDOWN_SECONDS=60

# Python logging level, such as INFO, WARNING, or DEBUG
LOG_LEVEL=INFO
